{%- comment -%}
  IDEAS brand palette (issue #12), concept A from the logo prototype: Ink
  (#0b1f3a) with the Transfer-Function Ramp's blue for light mode and sky for
  dark mode. These variable overrides re-brand every token-driven surface
  (navbar, links, buttons, dropdowns, cards, code backgrounds) in both modes;
  the al-folio defaults (purple light / cyan dark) no longer render anywhere.

  Both accents and both text colours meet WCAG AA (>= 4.5:1) against their
  background — asserted over the build output by test/assert_site.js.

  The header include is a local override (ADR-0001) rendered on every page,
  so the tokens need no extra stylesheet request; the footer override follows
  the same embedded-style pattern.
{%- endcomment -%}
{% include ideas-p1.liquid %}
<style>
  :root {
    --global-bg-color: #f7f8fb; /* the brand Background (ideas-colours.css) */
    --global-card-bg-color: #ffffff;
    --global-text-color: #0b1f3a; /* Ink */
    --global-text-color-light: #4a5a70;
    --global-theme-color: #1d4ed8; /* ramp blue */
    --global-hover-color: #1d4ed8;
    --global-divider-color: rgba(11, 31, 58, 0.1);
    --global-code-bg-color: rgba(29, 78, 216, 0.05);
  }
  html[data-theme='dark'] {
    --global-bg-color: #0b1f3a; /* Ink */
    --global-card-bg-color: #12294d;
    --global-code-bg-color: #132c50;
    --global-text-color: #d5deea;
    --global-text-color-light: #93a7c0;
    /* Sky instead of the ramp's starting navy: the first ramp steps nearly
       vanish on Ink (issue #12), and #1d4ed8 on Ink is only ~2:1. */
    --global-theme-color: #0ea5e9;
    --global-hover-color: #0ea5e9;
    --global-hover-text-color: #0b1f3a;
    --global-divider-color: rgba(213, 222, 234, 0.15);
  }

  /* The Horizontal Lockup: 40 px tall next to the nav (34 px on phones),
     per P1's one-row header. Width follows the SVG's own proportions. */
  .ideas-nav-logo {
    height: 40px;
    width: auto;
  }
  @media (max-width: 575.98px) {
    .ideas-nav-logo {
      height: 34px;
    }
  }
</style>
<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {%- comment -%}
        Local override (IDEAS): the brand is the Horizontal Lockup (Wordmark
        plus the three-line Tagline), shown on every page — including home,
        where al-folio hides the brand for a personal profile layout. The
        light and dark colour versions swap via the theme's only-light /
        only-dark classes; the dark variant is the on-Ink lockup with the
        ramp's start lightened (issue #12). Navbar social icons are dropped.
      {%- endcomment -%}
      <a class="navbar-brand" href="{{ site.baseurl }}/">
        <img
          class="only-light ideas-nav-logo"
          src="{{ '/assets/img/logo/ideas-horizontal-lockup-color-on-light.svg' | relative_url | bust_file_cache }}"
          alt="IDEAS — intelligent data exploration assistant for science"
        >
        <img
          class="only-dark ideas-nav-logo"
          src="{{ '/assets/img/logo/ideas-horizontal-lockup-color-on-ink-lightened.svg' | relative_url | bust_file_cache }}"
          alt="IDEAS — intelligent data exploration assistant for science"
        >
      </a>
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/' | relative_url }}"
              {% if page.permalink == '/' %}aria-current="page"{% endif %}
            >
              {{- about_title }}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a
                    class="nav-link"
                    href="{{ url | relative_url }}"
                    {% if page.url contains parent_link %}aria-current="page"{% endif %}
                  >
                    {{- p.title }}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
