{%- comment -%}
  P1 site design (issue #20): the shared look ported from the prototype's
  shell.css + p1.css (prototype/site-designs, throwaway) into the al-folio
  theme — ADR-0001 stands, so this restyles the theme rather than replacing
  it. Included from the header override on every page.

  The prototype's semantic tokens map onto the theme's --global-* variables,
  which the header override already re-points per mode (Ink text, ramp-blue
  accent in light; light text, sky accent on Ink in dark). Only tokens the
  theme lacks are defined here, prefixed --ideas-.
{%- endcomment -%}
<style>
  :root {
    --ideas-font-sans: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
    --ideas-font-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
    --ideas-shadow:
      0 1px 2px rgba(11, 31, 58, 0.08),
      0 8px 24px rgba(11, 31, 58, 0.06);
    /* The Ink hero band keeps its own colours in both modes (it is always an
       Ink surface); dark mode deepens it toward black like the prototype. */
    --ideas-hero-bg: #0b1f3a;
    --ideas-hero-text: #ffffff;
    --ideas-hero-muted: rgba(255, 255, 255, 0.76);
  }
  html[data-theme='dark'] {
    --ideas-hero-bg: #071527;
    --ideas-shadow: none;
  }

  body {
    font-family: var(--ideas-font-sans);
    /* Full-bleed bands (the Home hero) span 100vw, which includes the
       scrollbar; clip rather than hide so sticky positioning survives. */
    overflow-x: hidden;
    overflow-x: clip;
  }

  h1,
  h2,
  h3 {
    font-family: var(--ideas-font-sans);
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  /* Labels and dates are set in the mono family, uppercase (the prototype's
     .kicker / .date). */
  .ideas-kicker,
  .ideas-date {
    font-family: var(--ideas-font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ideas-kicker {
    margin: 0 0 6px;
    color: var(--global-text-color-light);
  }

  /* --------------------------------------------- Blocks and figure-led cards */
  .ideas-block {
    margin-top: 64px;
  }
  .ideas-block-head {
    align-items: baseline;
    border-bottom: 1px solid var(--global-divider-color);
    display: flex;
    gap: 16px;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-bottom: 10px;
  }
  .ideas-block-title {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0;
  }
  .ideas-block-more {
    flex: none;
    font: 500 0.8rem var(--ideas-font-mono);
    text-decoration: none;
  }
  .ideas-block-more::after {
    content: ' →';
  }

  .ideas-cards {
    display: grid;
    gap: 20px;
  }
  /* Objectives as a 2x2: room for a large figure and a short summary each. */
  .ideas-cards-objectives {
    gap: 24px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .ideas-cards-use-cases {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 720px) {
    .ideas-cards-objectives,
    .ideas-cards-use-cases {
      grid-template-columns: 1fr;
    }
  }

  .ideas-card {
    background: var(--global-card-bg-color);
    border: 1px solid var(--global-divider-color);
    border-radius: 10px;
    color: inherit;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .ideas-card:hover {
    border-color: var(--global-theme-color);
    box-shadow: var(--ideas-shadow);
    transform: translateY(-2px);
  }
  .ideas-card-media {
    aspect-ratio: 16 / 10;
    background: var(--global-card-bg-color);
    border-bottom: 1px solid var(--global-divider-color);
    overflow: hidden;
  }
  .ideas-card-media img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }
  /* Diagrams keep their own aspect inside the frame instead of cropping. */
  .ideas-card-media-diagram img {
    object-fit: contain;
    padding: 12px;
  }
  /* The ramp voxel tile for a card with no figure yet. */
  .ideas-card-media-grid {
    align-items: flex-end;
    background:
      repeating-linear-gradient(90deg, transparent 0 15px, #0b1f3a 15px 18px),
      repeating-linear-gradient(0deg, transparent 0 15px, #0b1f3a 15px 18px),
      linear-gradient(90deg, #1e3a8a, #1d4ed8, #0284c7, #0ea5e9, #14b8a6, #84cc16, #f59e0b);
    display: flex;
    padding: 12px;
    position: relative;
  }
  .ideas-card-grid-label {
    background: #0b1f3a;
    border-radius: 4px;
    color: #ffffff;
    font: 500 0.7rem var(--ideas-font-mono);
    letter-spacing: 0.04em;
    padding: 4px 8px;
  }
  .ideas-card-body {
    padding: 16px 18px 20px;
  }
  .ideas-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 6px;
  }
  .ideas-card-tagline {
    color: var(--global-text-color-light);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }
  .ideas-cards-objectives .ideas-card-body {
    padding: 20px 24px 24px;
  }
  .ideas-cards-objectives .ideas-card-title {
    font-size: 1.3rem;
  }
  .ideas-cards-objectives .ideas-card-tagline {
    color: var(--global-text-color);
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .ideas-card-summary {
    color: var(--global-text-color-light);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
  .ideas-cards-objectives .ideas-card-media-diagram img {
    padding: 20px;
  }

  /* ------------------------------------------------------- News and events */
  .ideas-news-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ideas-news-item {
    border-bottom: 1px solid var(--global-divider-color);
    display: grid;
    gap: 16px;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    padding: 14px 0;
  }
  .ideas-news-item:first-child {
    padding-top: 0;
  }
  .ideas-news-item .ideas-date {
    color: var(--global-text-color-light);
    padding-top: 3px;
  }
  .ideas-news-item-body p {
    margin: 0;
  }
  @media (max-width: 560px) {
    .ideas-news-item {
      gap: 4px;
      grid-template-columns: 1fr;
    }
  }

  .ideas-event-card {
    background: var(--global-card-bg-color);
    border: 1px solid var(--global-divider-color);
    border-left: 4px solid var(--global-theme-color);
    border-radius: 10px;
    padding: 20px;
  }
  .ideas-event-title {
    font-size: 1.15rem;
    margin: 0 0 8px;
  }
  .ideas-event-title a {
    color: inherit;
    text-decoration: none;
  }
  .ideas-event-dates {
    color: var(--global-text-color);
    font-size: 0.85rem;
    margin: 0 0 4px;
  }
  .ideas-event-meta {
    color: var(--global-text-color-light);
    font-size: 0.95rem;
    margin: 0;
  }

  /* The filled button (P1): ramp amber on Ink, in the hero and elsewhere. */
  .ideas-button {
    background: #f59e0b; /* ramp-7 */
    border-radius: 8px;
    color: #0b1f3a; /* Ink */
    display: inline-block;
    font-weight: 700;
    padding: 12px 20px;
    text-decoration: none;
  }
  .ideas-button:hover {
    background: color-mix(in srgb, #f59e0b 85%, white);
    color: #0b1f3a;
  }

  /* ------------------------------------------------------------ Header */
  /* P1's one-row header: the Horizontal Lockup and the nav on one line,
     sticky, on the white surface with a hairline rule underneath. The nav
     collapses under 1040px into a panel below the bar (P1's mobile nav). */
  #navbar {
    background: var(--global-card-bg-color);
    border-bottom: 1px solid var(--global-divider-color);
    box-shadow: none;
  }
  #navbar .container {
    max-width: 1140px;
    padding-left: 24px;
    padding-right: 24px;
  }
  #navbar .nav-link {
    position: relative;
    padding: 8px 10px;
    color: var(--global-text-color-light);
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    border-radius: 6px;
  }
  #navbar .nav-link:hover {
    color: var(--global-text-color);
    background: color-mix(in srgb, var(--global-divider-color) 50%, transparent);
  }
  #navbar .nav-link[aria-current='page'] {
    color: var(--global-text-color);
    font-weight: 600;
  }
  #navbar .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: -11px;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: var(--global-theme-color);
  }
  #navbar .navbar-toggler {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 12px;
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    background: transparent;
    color: var(--global-text-color);
    font: 500 0.8rem var(--ideas-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  #navbar .nav-link .fa-magnifying-glass {
    font-size: 0.85rem;
  }
  #navbar .toggle-container button {
    color: var(--global-text-color-light);
  }

  /* One row from 1040px up: the panel is a plain flex row and the toggle
     disappears. Below, the panel sits under the bar like P1's mobile nav. */
  @media (min-width: 1040px) {
    #navbar .navbar-collapse {
      display: flex !important;
      justify-content: flex-end;
    }
    #navbar .navbar-nav {
      flex-direction: row;
      align-items: center;
      gap: 4px;
    }
    #navbar .navbar-toggler {
      display: none;
    }
  }
  @media (max-width: 1039.98px) {
    #navbar .navbar-collapse.show {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 30;
      padding: 8px 16px 16px;
      background: var(--global-card-bg-color);
      border-bottom: 1px solid var(--global-divider-color);
      box-shadow: var(--ideas-shadow);
    }
    #navbar .nav-link {
      padding: 12px 8px;
      font-size: 1rem;
    }
    #navbar .nav-link[aria-current='page']::after {
      left: 0;
      right: auto;
      top: 12px;
      bottom: 12px;
      width: 3px;
      height: auto;
      border-radius: 0 3px 3px 0;
    }
  }

  /* P1 centres the page in a 1140px container (820px for narrow pages). */
  .container {
    max-width: 1140px;
  }

  /* ------------------------------------------------------------ Footer */
  .site-footer {
    margin-top: 80px;
    padding: 40px 0 32px;
    background: var(--global-card-bg-color);
    border-top: 1px solid var(--global-divider-color);
    text-align: center;
  }
  /* Partner logos are never recoloured: the strip always sits on white. */
  .ideas-partner-strip {
    max-width: 920px;
    margin: 0 auto 24px;
    padding: 16px 20px;
    background: #ffffff;
    border-radius: 10px;
  }
  .ideas-partner-strip-line {
    display: block;
    width: 100%;
    height: auto;
  }
  .ideas-partner-strip-grid {
    display: none;
  }
  @media (max-width: 640px) {
    .ideas-partner-strip-line {
      display: none;
    }
    .ideas-partner-strip-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    /* Each logo file is 108 units tall with 72 units of ink, and carries its
       own clear space, so no gap is added. At 72px the ink is 48px (0.5 in),
       which meets UNL's minimum height, the largest minimum among the
       partners. */
    .ideas-partner-strip-grid img {
      display: block;
      height: 72px;
      width: auto;
    }
  }
  .ideas-acknowledgment {
    max-width: 46rem;
    margin: 0 auto;
    color: var(--global-text-color-light);
    font-size: 0.85rem;
    line-height: 1.6;
  }
  @media (max-width: 560px) {
    .ideas-partner-strip {
      padding: 10px 8px;
    }
  }
</style>
