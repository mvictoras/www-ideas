---
layout: page
---
{% comment %}
  Events index. Groups the _events collection into Upcoming and Past relative
  to the build date (site.time), so an event moves from Upcoming to Past
  automatically on the first build after its end date has passed. The build
  harness (test/assert_site.js) asserts that the All-Hands Meeting is listed
  under Upcoming.

  P1 (issue #25): the groups are P1 section headings (rule underneath, via
  the shared .ideas-block system) and each Event is the same .ideas-event-card
  figure-led card as the Home page's next-event card — with its dates in the
  mono .ideas-date treatment.
{% endcomment %}

<style>
  /* P1's page head: title and lead (as on the Research page). */
  .post-header {
    padding: 56px 0 8px;
  }
  .post-title {
    font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
  }
  .post-description {
    color: var(--global-text-color-light);
    font-size: 1.15rem;
    margin: 0;
  }

  /* The Upcoming/Past groups are P1 blocks (the head carries the rule). */
  .event-group {
    margin-top: 64px;
  }
  .event-group .ideas-event-card + .ideas-event-card {
    margin-top: 20px;
  }
  .event-group-empty {
    color: var(--global-text-color-light);
  }
  @media (max-width: 560px) {
    .event-group {
      margin-top: 48px;
    }
  }
</style>

{{ content }}

{% comment %}
  Compare Unix timestamps (end of the event's last day, i.e. end_date + 1
  day) rather than raw Date objects: this works whether the front matter
  dates are parsed as Dates or left as strings, and keeps a whole-day event
  in Upcoming through its end date.
{% endcomment %}
{% assign build_now = site.time | date: '%s' | plus: 0 %}
{% assign upcoming_events = '' | split: '' %}
{% assign past_events = '' | split: '' %}
{% for event in site.events %}
  {% assign event_ends = event.end_date | date: '%s' | plus: 86400 %}
  {% if event_ends < build_now %}
    {% assign past_events = past_events | push: event %}
  {% else %}
    {% assign upcoming_events = upcoming_events | push: event %}
  {% endif %}
{% endfor %}
{% assign upcoming_events = upcoming_events | sort: 'start_date' %}
{% assign past_events = past_events | sort: 'start_date' | reverse %}

<div class="event-group" id="upcoming">
  <div class="ideas-block-head">
    <h2 class="ideas-block-title">Upcoming</h2>
  </div>
  {% if upcoming_events.size == 0 %}
    <p class="event-group-empty">No upcoming events yet.</p>
  {% endif %}
  {% for event in upcoming_events %}
    <article class="ideas-event-card">
      <p class="ideas-kicker">{{ event.event_type }}</p>
      <h3 class="ideas-event-title">
        <a href="{{ event.url | relative_url }}">{{ event.title }}</a>
      </h3>
      <p class="ideas-event-dates">
        <time class="ideas-date" datetime="{{ event.start_date | date: '%Y-%m-%d' }}">
          {%- if event.start_date == event.end_date -%}
            {{ event.start_date | date: '%B %-d, %Y' }}
          {%- else -%}
            {{ event.start_date | date: '%B %-d' }} – {{ event.end_date | date: '%B %-d, %Y' }}
          {%- endif -%}
        </time>
      </p>
      <p class="ideas-event-meta">
        {%- if event.venue and event.venue.name %}{{ event.venue.name }}{% else %}Venue TBA{% endif %}
        · {{ event.format -}}
        {%- if event.rsvp_required %} · RSVP required{% endif -%}
      </p>
    </article>
  {% endfor %}
</div>

<div class="event-group" id="past">
  <div class="ideas-block-head">
    <h2 class="ideas-block-title">Past</h2>
  </div>
  {% if past_events.size == 0 %}
    <p class="event-group-empty">No past events yet.</p>
  {% endif %}
  {% for event in past_events %}
    <article class="ideas-event-card">
      <p class="ideas-kicker">{{ event.event_type }}</p>
      <h3 class="ideas-event-title">
        <a href="{{ event.url | relative_url }}">{{ event.title }}</a>
      </h3>
      <p class="ideas-event-dates">
        <time class="ideas-date" datetime="{{ event.start_date | date: '%Y-%m-%d' }}">
          {%- if event.start_date == event.end_date -%}
            {{ event.start_date | date: '%B %-d, %Y' }}
          {%- else -%}
            {{ event.start_date | date: '%B %-d' }} – {{ event.end_date | date: '%B %-d, %Y' }}
          {%- endif -%}
        </time>
      </p>
      <p class="ideas-event-meta">
        {%- if event.venue and event.venue.name %}{{ event.venue.name }}{% else %}Venue TBA{% endif %}
        · {{ event.format -}}
        {%- if event.rsvp_required %} · RSVP required{% endif -%}
      </p>
    </article>
  {% endfor %}
</div>
