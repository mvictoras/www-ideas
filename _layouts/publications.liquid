---
layout: page
---
{% comment %}
  Publications. Restyles the jekyll-scholar bibliography in the P1 design
  (issue #23) via CSS only — the gem renders the markup (year-group
  <h2 class="bibliography"> headings, entry divs keyed by citation key,
  .periodical venue lines, BibTeX/abstract toggles) and must stay
  byte-compatible for test/assert_site.js. The look reuses the P1 pieces:
  section headings with a rule underneath, figure-led card surfaces (white,
  1px rule, 10px radius, lift on hover) for the entries, JetBrains Mono for
  the year labels, and the brand token colours for both modes.
{% endcomment %}

<style>
  /* P1's container-narrow for the reading list. This block renders only on
     pages using the publications layout, so the cap is effectively
     page-scoped. */
  .container {
    max-width: 920px;
  }

  /* P1's page head: title and lead (the gem's page layout renders them). */
  .post-header {
    padding: 56px 0 8px;
  }
  .post-title {
    font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
  }
  .post-description {
    color: var(--global-text-color-light);
    font-size: 1.15rem;
    margin: 0;
  }

  /* The bibsearch field: a P1 input — white surface, hairline rule, mono-
     sized label — instead of the al-folio newsletter colours. */
  .bibsearch-form-input {
    background: var(--global-card-bg-color);
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    color: var(--global-text-color);
    font-family: var(--ideas-font-sans);
    font-size: 0.95rem;
    margin: 0 0 8px;
    max-width: 420px;
  }
  .bibsearch-form-input:focus {
    border-color: var(--global-theme-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--global-theme-color) 18%, transparent);
    color: var(--global-text-color);
  }
  .bibsearch-form-input::placeholder {
    color: var(--global-text-color-light);
  }

  /* Year-group headings: P1 section headings with a rule underneath, set in
     the mono family like the kickers and dates. One rule per year group. */
  .publications h2.bibliography {
    border-bottom: 1px solid var(--global-divider-color);
    color: var(--global-text-color);
    font-family: var(--ideas-font-mono);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    margin: 56px 0 16px;
    padding-bottom: 10px;
    text-align: left;
    text-transform: uppercase;
  }
  .publications h2.bibliography:first-child {
    margin-top: 16px;
  }

  /* Entries as P1 cards: white surface, 1px rule, 10px radius, lift on
     hover. The list itself is the stack; the gem's li margin is replaced by
     the grid gap. */
  .publications ol.bibliography {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* The grid items (and the Bootstrap columns) must be allowed to shrink
     below their content width, or the BibTeX <pre>'s long lines blow the
     cards out past the viewport. */
  .publications ol.bibliography > li {
    margin-bottom: 0;
    min-width: 0;
    padding: 0;
  }
  .publications ol.bibliography .row {
    background: var(--global-card-bg-color);
    border: 1px solid var(--global-divider-color);
    border-radius: 10px;
    display: block;
    margin: 0;
    padding: 20px 22px;
    transition:
      border-color 0.15s,
      transform 0.15s,
      box-shadow 0.15s;
  }
  .publications ol.bibliography .row:hover {
    border-color: var(--global-theme-color);
    box-shadow: var(--ideas-shadow);
    transform: translateY(-2px);
  }
  /* The thumbnail/abbr column only exists when an entry carries one; the
     grid column otherwise collapses instead of leaving dead space. */
  .publications ol.bibliography .row > [class*='col'] {
    max-width: 100%;
    min-width: 0;
    padding: 0;
    width: 100%;
  }
  .publications .abbr {
    display: none;
  }
  .publications .abbr:has(abbr, img, video) {
    display: block;
    margin-bottom: 12px;
  }

  /* Entry typography. al-folio paints div/em/strong with the text colour
     directly, so each element is re-declared here (landmine #2). */
  .publications .title {
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .publications .author {
    color: var(--global-text-color-light);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-top: 4px;
  }
  .publications .author strong {
    color: var(--global-text-color);
    font-weight: 600;
  }
  .publications .periodical {
    color: var(--global-text-color-light);
    font-size: 0.9rem;
  }
  .publications .periodical em {
    color: inherit;
  }

  /* The link buttons (Abs / DOI / arXiv / Bib / …): P1's mono chips. */
  .publications .links {
    margin-top: 12px;
  }
  .publications .links a.btn {
    background: transparent;
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    box-shadow: none;
    color: var(--global-text-color);
    font: 500 0.75rem var(--ideas-font-mono);
    letter-spacing: 0.04em;
    padding: 5px 12px;
    text-transform: uppercase;
  }
  .publications .links a.btn:hover,
  .publications .links a.btn:focus {
    border-color: var(--global-theme-color);
    box-shadow: none;
    color: var(--global-theme-color);
  }
  .publications .links a.award.btn {
    border-color: var(--global-theme-color);
    color: var(--global-theme-color);
  }

  /* The toggled abstract panel sits inside the card on the P1 surface,
     separated by a hairline — visible only once opened (the gem's closed
     border is painted in the page background, which ghosts on the card). */
  .publications ol.bibliography li div.abstract.hidden {
    border: 1px dashed transparent;
  }
  .publications ol.bibliography li div.abstract.hidden.open {
    border-color: var(--global-theme-color);
    margin-top: 12px;
  }
  .publications div.bibtex.hidden {
    border: none;
  }
  .publications div.bibtex.hidden pre {
    background: var(--global-code-bg-color);
    border-radius: 8px;
    overflow-x: auto;
  }

  @media (max-width: 575.98px) {
    .publications ol.bibliography .row {
      padding: 16px;
    }
  }
</style>

{{ content }}
