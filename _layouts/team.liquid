---
layout: page
---
{% comment %}
  Team grid (P1, issue #22). Renders every entry in _data/team.yml as one
  figure-led card grid — Argonne and Partner members together, not grouped by
  institution type. The build harness (test/assert_site.js) asserts the visible
  grid matches the data file 1:1: a consistently-cropped photo or a
  brand-coloured initials placeholder, the role, the institution as a mono
  kicker, and exactly the per-member links from the data file.
{% endcomment %}
{% assign team = site.data.team %}
{% assign institution_count = team | map: 'institution' | uniq | size %}

<style>
  /* The P1 section: heading with the rule underneath, then the grid. */
  .team-block {
    margin-top: 48px;
  }
  .team-block-meta {
    color: var(--global-text-color-light);
    margin: 0;
  }

  /* P1's figure-led cards in an auto-fill grid: one column on phones, up to
     four across the 1140px container. */
  .team-grid {
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }

  /* Every photo crops to the same square frame; the placeholder fills the
     same frame, so the grid stays even with or without a photo. */
  .team-media {
    aspect-ratio: 1 / 1;
  }

  /* The brand-coloured placeholder for members without a photo: the P1 ramp
     voxel tile (as for cards without figures) with the initials on an Ink
     chip. Fixed colours, legible in both modes. */
  .team-avatar {
    align-items: center;
    background:
      repeating-linear-gradient(90deg, transparent 0 15px, #0b1f3a 15px 18px), repeating-linear-gradient(0deg, transparent 0 15px, #0b1f3a 15px 18px),
      linear-gradient(90deg, #1e3a8a, #1d4ed8, #0284c7, #0ea5e9, #14b8a6, #84cc16, #f59e0b);
    display: flex;
    height: 100%;
    justify-content: center;
    width: 100%;
  }
  .team-avatar-initials {
    background: #0b1f3a; /* Ink */
    border-radius: 6px;
    color: #ffffff;
    font: 600 1.5rem var(--ideas-font-mono);
    letter-spacing: 0.04em;
    padding: 8px 16px;
  }

  .team-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    padding: 18px 20px 20px;
  }
  .team-name {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
  }
  .team-role {
    color: var(--global-text-color);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0 0 6px;
  }
  .team-institution {
    margin: 0 0 16px;
  }
  .team-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    list-style: none;
    margin: auto 0 0;
    padding: 0;
  }
  /* P1's mono link treatment (as the block "more" links), uppercase. */
  .team-links a {
    color: var(--global-theme-color);
    font: 500 0.75rem var(--ideas-font-mono);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .team-links a:hover {
    text-decoration: underline;
  }
</style>

<div class="ideas-block team-block">
  <div class="ideas-block-head">
    <h2 class="ideas-block-title">Team Members</h2>
    <p class="ideas-kicker team-block-meta">{{ team.size }} members · {{ institution_count }} institutions</p>
  </div>
  <div class="team-grid ideas-cards">
    {% for member in team %}
      <div class="team-card ideas-card">
        <div class="team-media ideas-card-media">
          {% if member.photo %}
            <img
              class="team-photo"
              src="{{ 'assets/img/team/' | append: member.photo | relative_url }}"
              alt="Photo of {{ member.name }}"
              loading="lazy"
            >
          {% else %}
            {% assign words = member.name | split: ' ' %}
            {% assign initials = words.first | slice: 0, 1 | upcase %}
            {% if words.size > 1 %}
              {% assign last_initial = words.last | slice: 0, 1 | upcase %}
              {% assign initials = initials | append: last_initial %}
            {% endif %}
            <div class="team-avatar" aria-hidden="true">
              <span class="team-avatar-initials">{{ initials }}</span>
            </div>
          {% endif %}
        </div>
        <div class="team-card-body ideas-card-body">
          <h3 class="team-name">{{ member.name }}</h3>
          <p class="team-role">{{ member.role }}</p>
          <p class="team-institution ideas-kicker">{{ member.institution }}</p>
          {% if member.links %}
            <ul class="team-links">
              {% if member.links.homepage %}
                <li><a href="{{ member.links.homepage }}" aria-label="{{ member.name }} — homepage">Homepage</a></li>
              {% endif %}
              {% if member.links.orcid %}
                <li><a href="{{ member.links.orcid }}" aria-label="{{ member.name }} — ORCID">ORCID</a></li>
              {% endif %}
              {% if member.links.scholar %}
                <li><a href="{{ member.links.scholar }}" aria-label="{{ member.name }} — Google Scholar">Scholar</a></li>
              {% endif %}
              {% if member.links.github %}
                <li><a href="{{ member.links.github }}" aria-label="{{ member.name }} — GitHub">GitHub</a></li>
              {% endif %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
