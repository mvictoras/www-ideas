---
layout: default
---
{% comment %}
  Home landing page (issue #10) — replaces al-folio's personal "about"
  profile. The page body (_pages/about.md) is split at a "home-blocks" HTML
  comment marker: the part before it is the hypothesis hero copy, the part
  after it is the sibling-Thrust note. Between them the layout renders the
  blocks from their sources, so they stay current without edits:

  - Objective cards: the projects collection (category: objective), in
    importance order, each linking to its anchor on the Research page.
  - Use Case cards: the projects collection (category: use-case), Active
    before Upcoming, each linking to its anchor on the Use Cases page.
  - Latest news: the theme's news.liquid include, limited to the newest
    page.announcements.limit News Items from the _news collection.
  - Upcoming events: the next Event (relative to the build date) from the
    _events collection, by the same rule as the Events index.

  The build harness (test/assert_site.js) asserts the blocks render and the
  site-wide TIDES rule holds.
{% endcomment %}
{% assign story = content | split: '<!-- home-blocks -->' %}

<style>
  .home-hero {
    margin-bottom: 3rem;
  }

  .home-hero-title {
    font-size: 2.1rem;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .home-hero-copy {
    font-size: 1.3rem;
    line-height: 1.6;
    margin-bottom: 0;
  }

  .home-grid {
    align-items: start;
    display: grid;
    gap: 2.5rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
  }

  .home-block-title {
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .home-block-title a {
    color: inherit;
  }

  .home-cards {
    display: grid;
    gap: 1rem;
  }

  .home-card {
    background-color: var(--global-card-bg-color);
    border: 1px solid var(--global-divider-color);
    border-radius: 0.5rem;
    color: inherit;
    display: block;
    padding: 1.25rem 1.1rem;
  }

  .home-card:hover {
    border-color: var(--global-theme-color);
    text-decoration: none;
  }

  .home-card-kicker {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    margin-bottom: 0.25rem;
    text-transform: uppercase;
  }

  .home-card-name {
    font-size: 1.15rem;
    margin-bottom: 0.25rem;
  }

  .home-card-tagline {
    color: var(--global-text-color-light);
    margin-bottom: 0;
  }

  .home-news {
    margin-bottom: 0;
  }

  .home-event-card {
    background-color: var(--global-card-bg-color);
    border: 1px solid var(--global-divider-color);
    border-radius: 0.5rem;
    padding: 1.25rem 1.1rem;
  }

  .home-event-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .home-event-dates {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .home-event-meta {
    color: var(--global-text-color-light);
    margin-bottom: 0;
  }

  .home-more {
    margin-bottom: 0;
    margin-top: 1.25rem;
  }

  .home-sibling {
    border-top: 1px solid var(--global-divider-color);
    color: var(--global-text-color-light);
    margin-top: 3.5rem;
    padding-top: 1.5rem;
  }

  .home-sibling p {
    margin-bottom: 0;
  }

  @media (max-width: 575.98px) {
    .home-hero-title {
      font-size: 1.6rem;
    }

    .home-hero-copy {
      font-size: 1.15rem;
    }
  }
</style>

<section class="home-hero">
  <h1 class="home-hero-title">Intelligent Data Exploration Assistant for Science</h1>
  {{ story[0] }}
</section>

<div class="home-grid">
  <div class="home-objectives" id="objectives">
    <h2 class="home-block-title">
      <a href="{{ '/research/' | relative_url }}">Objectives</a>
    </h2>
    <div class="home-cards">
      {% assign objectives = site.projects | where: 'category', 'objective' | sort: 'importance' %}
      {% for objective in objectives %}
        <a class="home-card" href="{{ '/research/' | relative_url }}#{{ objective.slug }}">
          <p class="home-card-kicker">Objective {{ forloop.index }}</p>
          <h3 class="home-card-name">{{ objective.title }}</h3>
          <p class="home-card-tagline">{{ objective.tagline }}</p>
        </a>
      {% endfor %}
    </div>
  </div>

  <div class="home-use-cases" id="use-cases">
    <h2 class="home-block-title">
      <a href="{{ '/use-cases/' | relative_url }}">Use Cases</a>
    </h2>
    <div class="home-cards">
      {% assign use_case_statuses = 'active,upcoming' | split: ',' %}
      {% for status in use_case_statuses %}
        {% assign home_use_cases = site.projects | where: 'category', 'use-case' | where: 'status', status | sort: 'importance' %}
        {% for use_case in home_use_cases %}
          <a class="home-card" href="{{ '/use-cases/' | relative_url }}#{{ use_case.slug }}">
            <p class="home-card-kicker">{{ status | capitalize }} Use Case</p>
            <h3 class="home-card-name">{{ use_case.title }}</h3>
            <p class="home-card-tagline">{{ use_case.tagline }}</p>
          </a>
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  <div class="home-news" id="news">
    <h2 class="home-block-title">
      <a href="{{ '/news/' | relative_url }}">Latest news</a>
    </h2>
    {% include news.liquid limit=true %}
    <p class="home-more">
      <a href="{{ '/news/' | relative_url }}">All news</a>
    </p>
  </div>

  <div class="home-events" id="events">
    <h2 class="home-block-title">
      <a href="{{ '/events/' | relative_url }}">Upcoming events</a>
    </h2>
    {% comment %}
      The same upcoming/past rule as the Events index: an event is past only
      once its end date has fully passed, so a whole-day event stays
      upcoming through its end date.
    {% endcomment %}
    {% assign build_now = site.time | date: '%s' | plus: 0 %}
    {% assign home_upcoming_events = '' | split: '' %}
    {% for event in site.events %}
      {% assign event_ends = event.end_date | date: '%s' | plus: 86400 %}
      {% if event_ends >= build_now %}
        {% assign home_upcoming_events = home_upcoming_events | push: event %}
      {% endif %}
    {% endfor %}
    {% assign home_upcoming_events = home_upcoming_events | sort: 'start_date' %}
    {% if home_upcoming_events.size > 0 %}
      {% assign next_event = home_upcoming_events.first %}
      <article class="home-event-card">
        <p class="home-card-kicker">{{ next_event.event_type }}</p>
        <h3>
          <a href="{{ next_event.url | relative_url }}">{{ next_event.title }}</a>
        </h3>
        <p class="home-event-dates">
          {% if next_event.start_date == next_event.end_date %}
            {{ next_event.start_date | date: '%B %-d, %Y' }}
          {% else %}
            {{ next_event.start_date | date: '%B %-d' }} – {{ next_event.end_date | date: '%B %-d, %Y' }}
          {% endif %}
        </p>
        <p class="home-event-meta">
          {% if next_event.venue and next_event.venue.name %}{{ next_event.venue.name }}{% else %}Venue TBA{% endif %}
          · {{ next_event.format -}}
          {%- if next_event.rsvp_required %} · RSVP required{% endif %}
        </p>
      </article>
    {% else %}
      <p>No upcoming events yet.</p>
    {% endif %}
    <p class="home-more">
      <a href="{{ '/events/' | relative_url }}">All events</a>
    </p>
  </div>
</div>

{% if story[1] %}
  <section class="home-sibling">
    {{ story[1] }}
  </section>
{% endif %}
