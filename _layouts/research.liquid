---
layout: page
---
{% comment %}
  Research page. The page body is split at an "objectives" HTML comment
  marker: the part before it is the opening story, the part after it is the
  closing. Between them, every Objective in the projects collection (category:
  objective, ordered by importance) renders as a numbered essay. The build
  harness (test/assert_site.js) asserts the four Objectives and the figures.
{% endcomment %}
{% assign story = content | split: '<!-- objectives -->' %}

<style>
  /* P1's container-narrow for the essay. This block renders only on pages
     using the research layout, so the cap is effectively page-scoped. */
  .container {
    max-width: 820px;
  }

  /* The P1 page head (title and lead) comes from the generic page-layout
     override (_layouts/page.liquid, issue #26). */

  article p {
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .research-lede {
    font-size: 1.25rem;
    line-height: 1.7;
    margin-top: 32px;
  }

  .objective {
    border-top: 1px solid var(--global-divider-color);
    margin-top: 56px;
    padding-top: 32px;
    scroll-margin-top: 72px;
  }

  .objective-kicker {
    color: var(--global-theme-color);
  }

  .objective h2 {
    font-size: 1.85rem;
    font-weight: 700;
    margin-top: 0;
  }

  .objective-tagline {
    color: var(--global-text-color-light);
    font-size: 1.3rem;
    font-style: normal;
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: 24px;
  }

  .research-closing {
    border-top: 1px solid var(--global-divider-color);
    margin-top: 56px;
    padding-top: 32px;
  }
</style>

{{ story[0] }}

{% assign objectives = site.projects | where: 'category', 'objective' | sort: 'importance' %}
{% for objective in objectives %}
  <section class="objective" id="{{ objective.slug }}">
    <p class="ideas-kicker objective-kicker">Objective {{ forloop.index }}</p>
    <h2>{{ objective.title }}</h2>
    <p class="objective-tagline">{{ objective.tagline }}</p>
    {{ objective.content | markdownify }}
    {% if objective.figure %}
      <figure class="ideas-figure">
        <div class="ideas-figure-frame">
          <img src="{{ objective.figure.src | relative_url }}" alt="{{ objective.figure.alt }}">
        </div>
        <figcaption>{{ objective.figure.caption }} <span class="credit">Credit: {{ objective.figure.credit }}</span></figcaption>
      </figure>
    {% endif %}
  </section>
{% endfor %}

{% if story[1] %}
  <div class="research-closing">
    {{ story[1] }}
  </div>
{% endif %}
